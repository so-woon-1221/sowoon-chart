{
  "name": "@sowoon1221/sowoon-chart",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "dist/types"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --outDir preview-dist",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --outDir preview-dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-rollup": "rimraf dist && rollup -c",
    "clean:publish-maps": "node -e \"const fs=require('node:fs');const path=require('node:path');if(!fs.existsSync('dist'))process.exit(0);for(const file of fs.readdirSync('dist')){if(file.endsWith('.map'))fs.rmSync(path.join('dist',file),{force:true});}\"",
    "build:package": "npm run build-rollup && npm run clean:publish-maps",
    "pack:dry-run": "npm run build:package && npm pack --dry-run",
    "prepare": "husky install",
    "prepublishOnly": "npm run build:package",
    "publish:package": "npm publish"
  },
  "dependencies": {
    "d3-cloud": "^1.2.7",
    "html-to-image": "^1.11.11"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.24.7",
    "@chromatic-com/storybook": "^5.1.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.4",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^26.0.3",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@storybook/addon-links": "^10.3.4",
    "@storybook/addon-onboarding": "^10.3.4",
    "@storybook/react": "^10.3.4",
    "@storybook/react-vite": "^10.3.4",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "d3": "^7.9.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^10.3.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.0.1",
    "rollup": "^4.60.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-web-worker-loader": "^1.6.1",
    "storybook": "^10.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.3",
    "@storybook/addon-docs": "^10.3.4"
  },
  "peerDependencies": {
    "d3": ">=7 <8",
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
